generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  password          String
  firstName         String
  lastName          String
  role              String              @default("admin")
  avatarUrl         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  quotes            Quote[]
  invoices          Invoice[]
  expenses          Expense[]
  contracts         Contract[]
  tasks             Task[]              @relation("AssignedTasks")
  createdTasks      Task[]              @relation("CreatedTasks")
  activityLogs      ActivityLog[]
  campaigns         MarketingCampaign[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  calendarEvents    CalendarEvent[]
}

model Client {
  id                 String             @id @default(cuid())
  type               String
  name               String
  email              String?
  phone              String?
  organization       String?
  acquisitionChannel String?
  status             String             @default("prospect")
  tvaExempt          Boolean            @default(false)
  notes              String?
  tags               String[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  projects           Project[]
  quotes             Quote[]
  invoices           Invoice[]
  contracts          Contract[]
  marketingContacts  MarketingContact[]
  quoteRequests      QuoteRequest[]
}

model Project {
  id             String     @id @default(cuid())
  clientId       String
  title          String
  type           String
  status         String     @default("prospect")
  date           DateTime?
  location       String?
  budgetEstimate Float?
  notes          String?
  createdBy      String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  client         Client     @relation(fields: [clientId], references: [id])
  quotes         Quote[]
  invoices       Invoice[]
  expenses       Expense[]
  contracts      Contract[]
}

model Quote {
  id         String         @id @default(cuid())
  reference  String         @unique
  clientId   String
  projectId  String?
  subject    String
  status     String         @default("brouillon")
  brsEnabled Boolean        @default(false)
  tvaEnabled Boolean        @default(false)
  subtotalHt Float          @default(0)
  brsAmount  Float          @default(0)
  tvaAmount  Float          @default(0)
  totalTtc   Float          @default(0)
  validUntil DateTime?
  notes      String?
  createdBy  String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  client     Client         @relation(fields: [clientId], references: [id])
  project    Project?       @relation(fields: [projectId], references: [id])
  creator    User           @relation(fields: [createdBy], references: [id])
  lines      QuoteLine[]
  invoices   Invoice[]
  requests   QuoteRequest[]
}

model QuoteLine {
  id          String @id @default(cuid())
  quoteId     String
  description String
  quantity    Float
  unitPrice   Float
  total       Float
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model Invoice {
  id         String        @id @default(cuid())
  reference  String        @unique
  clientId   String
  projectId  String?
  quoteId    String?
  subject    String?
  type       String        @default("standard")
  status     String        @default("emise")
  brsEnabled Boolean       @default(false)
  tvaEnabled Boolean       @default(false)
  subtotalHt Float         @default(0)
  brsAmount  Float         @default(0)
  tvaAmount  Float         @default(0)
  totalTtc   Float         @default(0)
  issuedAt   DateTime      @default(now())
  dueAt      DateTime?
  paidAt     DateTime?
  notes      String?
  createdBy  String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  client     Client        @relation(fields: [clientId], references: [id])
  project    Project?      @relation(fields: [projectId], references: [id])
  quote      Quote?        @relation(fields: [quoteId], references: [id])
  creator    User          @relation(fields: [createdBy], references: [id])
  lines      InvoiceLine[]
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float
  unitPrice   Float
  total       Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  amount      Float
  date        DateTime
  description String
  projectId   String?
  createdBy   String
  createdAt   DateTime @default(now())
  project     Project? @relation(fields: [projectId], references: [id])
  creator     User     @relation(fields: [createdBy], references: [id])
}

// Une session est une cohorte d'un programme de formation. title est
// conserve pour compatibilite ("Programme · label"), l'affichage passe par
// cohortDisplayName (lib/formations.ts).
model TrainingSession {
  id            String                 @id @default(cuid())
  programId     String
  label         String?
  scheduleText  String?
  title         String
  dateStart     DateTime?
  dateEnd       DateTime?
  location      String
  maxSeats      Int
  price         Float
  description   String?
  status        String                 @default("ouvert")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  registrations TrainingRegistration[]
  program       TrainingProgram        @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@index([programId])
}

model TrainingRegistration {
  id               String          @id @default(cuid())
  sessionId        String
  firstName        String
  lastName         String
  email            String
  phone            String?
  status           String          @default("en_attente")
  waitlistPosition Int?
  message          String?
  registeredAt     DateTime        @default(now())
  confirmedAt      DateTime?
  amountPaid       Float?
  // Fin du delai de paiement d'une reservation en_attente (pas de liberation auto)
  holdExpiresAt    DateTime?
  session          TrainingSession @relation(fields: [sessionId], references: [id])
}

model PortfolioItem {
  id           String    @id @default(cuid())
  title        String
  type         String
  date         DateTime?
  description  String?
  mediaType    String
  mediaUrl     String
  thumbnailUrl String?
  published    Boolean   @default(false)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Contract {
  id           String    @id @default(cuid())
  projectId    String
  clientId     String
  templateType String
  status       String    @default("a_envoyer")
  notes        String?
  fileUrl      String?
  signedAt     DateTime?
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  project      Project   @relation(fields: [projectId], references: [id])
  client       Client    @relation(fields: [clientId], references: [id])
  creator      User      @relation(fields: [createdBy], references: [id])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  entityType  String
  entityId    String?
  description String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Task {
  id         String    @id @default(cuid())
  title      String
  dueDate    DateTime?
  completed  Boolean   @default(false)
  assignedTo String?
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  assignee   User?     @relation("AssignedTasks", fields: [assignedTo], references: [id])
  creator    User      @relation("CreatedTasks", fields: [createdBy], references: [id])
}

model MarketingContact {
  id           String   @id @default(cuid())
  clientId     String?
  email        String   @unique
  firstName    String?
  lastName     String?
  lists        String[]
  unsubscribed Boolean  @default(false)
  createdAt    DateTime @default(now())
  client       Client?  @relation(fields: [clientId], references: [id])
}

model MarketingCampaign {
  id           String          @id @default(cuid())
  title        String
  templateType String?
  subject      String
  body         String
  lists        String[]
  status       String          @default("brouillon")
  scheduledAt  DateTime?
  sentAt       DateTime?
  createdBy    String
  createdAt    DateTime        @default(now())
  creator      User            @relation(fields: [createdBy], references: [id])
  opens        CampaignOpen[]
  clicks       CampaignClick[]
}

model CampaignOpen {
  id           String            @id @default(cuid())
  campaignId   String
  contactEmail String
  openedAt     DateTime          @default(now())
  userAgent    String?
  campaign     MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([contactEmail])
}

model CampaignClick {
  id           String            @id @default(cuid())
  campaignId   String
  contactEmail String
  url          String
  clickedAt    DateTime          @default(now())
  userAgent    String?
  campaign     MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([contactEmail])
}

model Setting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model Offer {
  id           String   @id @default(cuid())
  serviceType  String
  name         String
  price        Float?
  priceLabel   String?
  features     String[]
  isPopular    Boolean  @default(false)
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  type       String
  title      String
  message    String
  entityType String?
  entityId   String?
  entityUrl  String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CalendarEvent {
  id        String    @id @default(cuid())
  title     String
  date      DateTime
  endDate   DateTime?
  type      String    @default("evenement")
  color     String    @default("#6B7280")
  notes     String?
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  creator   User      @relation(fields: [createdBy], references: [id])

  @@index([createdBy])
  @@index([date])
}

// Hero de l'accueil : carrousel video (5 slides maximum)
enum HeroVideoType {
  YOUTUBE
  MP4
  NONE
}

model HeroSlide {
  id          String        @id @default(cuid())
  order       Int           @default(0)
  active      Boolean       @default(true)
  kicker      String
  titleLine1  String
  titleLine2  String
  accentText  String?
  description String
  videoType   HeroVideoType @default(NONE)
  youtubeUrl  String?
  youtubeId   String?
  mp4Url      String?
  posterUrl   String?
  cta1Label   String
  cta1Href    String
  cta2Label   String?
  cta2Href    String?
  soundLabel  String        @default("Regarder avec le son")
  badgeText   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([active, order])
}

// Temoignages (accueil : GENERAL ; parcours d'anciens : FORMATION).
// Publication possible seulement avec l'accord de la personne (consent).
enum TestimonialContext {
  GENERAL
  FORMATION
}

model Testimonial {
  id         String             @id @default(cuid())
  quote      String
  authorName String
  authorRole String?
  photoUrl   String?
  context    TestimonialContext @default(GENERAL)
  consent    Boolean            @default(false)
  published  Boolean            @default(false)
  order      Int                @default(0)
  programId  String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  program    TrainingProgram?   @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([context, published, order])
  @@index([programId])
}

// Programme de formation (ex. Realisation multicam) : fiche, plaquette PDF
// et cohortes (TrainingSession)
model TrainingProgram {
  id                String            @id @default(cuid())
  slug              String            @unique
  code              String?
  name              String
  tagline           String?
  description       String?
  disciplines       String[]
  sessionsCount     Int?
  theoryHours       Int?
  practiceHours     Int?
  level             String?
  audience          String?
  objectives        String[]
  curriculum        Json?
  stats             Json?
  leadName          String?
  leadRole          String?
  contactEmail      String?
  contactPhone      String?
  defaultPrice      Float?
  defaultMaxSeats   Int?
  brochureUrl       String?
  brochurePath      String?
  brochureTitle     String?
  brochureFileName  String?
  brochureSize      Int?
  brochurePages     Int?
  brochureUpdatedAt DateTime?
  brochurePublished Boolean           @default(false)
  published         Boolean           @default(true)
  order             Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  cohorts           TrainingSession[]
  testimonials      Testimonial[]
  galleryAlbums     GalleryAlbum[]
}

// Demande de devis du site (/contact). need : evenement_live, ceo_content,
// creator_weekend, formation, autre. status : nouvelle, en_cours,
// devis_envoye, convertie, sans_suite.
model QuoteRequest {
  id           String    @id @default(cuid())
  clientId     String
  need         String
  desiredDate  DateTime?
  location     String?
  organization String?
  platforms    String[]
  cameras      String?
  participants Int?
  description  String?
  status       String    @default("nouvelle")
  quoteId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quote        Quote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([clientId])
}

// Galerie photos par albums (prompt 7). category : evenements, formations,
// coulisses. coverPhotoId sans contrainte : sans couverture valide, la
// premiere photo selon order sert de couverture.
model GalleryAlbum {
  id           String           @id @default(cuid())
  slug         String           @unique
  title        String
  description  String?
  date         DateTime?
  category     String
  programId    String?
  program      TrainingProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  coverPhotoId String?
  published    Boolean          @default(false)
  order        Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  photos       GalleryPhoto[]

  @@index([published, category, date])
}

// Photo d'un album : grande taille (url, path) et miniature (thumbUrl,
// thumbPath) produites dans le navigateur, bucket galerie
model GalleryPhoto {
  id        String       @id @default(cuid())
  albumId   String
  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url       String
  path      String
  thumbUrl  String
  thumbPath String
  width     Int
  height    Int
  alt       String?
  caption   String?
  order     Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([albumId, order])
}
